@startuml
left to right direction

actor "User" as U
actor "Weekly Report Scheduler" as S <<System>>

rectangle "Weekly Spending Summary System (US 5.12)" {
  usecase "Open Weekly Digest\nNotification" as UC1
  usecase "View Weekly Financial\nAnalytics Breakdown" as UC2
  usecase "Generate Weekly\nSpending Report" as UC3
  usecase "Dispatch Weekly Summary\nNotification" as UC4
  usecase "Summarize Total Spend, Top Category\n& Week-over-Week % Change" as UC5
}

U --> UC1
UC1 ..> UC2 : <<include>>

S --> UC3
UC3 <.. UC4 : <<extend>>\n[If a calendar week is completed]
UC4 ..> UC5 : <<include>>
@enduml
