@startuml
left to right direction

actor "User" as U
actor "Notification Engine" as S <<System>>

rectangle "Do-Not-Disturb Quiet Hours System (US 5.15)" {
  usecase "Configure Quiet Hours\n(Do-Not-Disturb)" as UC1
  usecase "Set Start & End Time" as UC2
  usecase "Process Generated Alert" as UC3
  usecase "Suppress Push Sound/Banner &\nQueue for Morning Inbox" as UC4
  usecase "Monitor Quiet Hours\nEnd Time" as UC5
  usecase "Surface Queued Notifications\nDigest in Notification Center" as UC6
}

U --> UC1
UC1 ..> UC2 : <<include>>

S --> UC3
UC3 <.. UC4 : <<extend>>\n[If alert is non-urgent and quiet hours are active]

S --> UC5
UC5 <.. UC6 : <<extend>>\n[If the quiet hours end time is reached]
@enduml
