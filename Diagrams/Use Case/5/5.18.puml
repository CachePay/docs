@startuml
left to right direction

actor "User" as U
actor "Notification Engine" as S <<System>>

rectangle "Notification Preference System (US 5.18)" {
  usecase "Manage Notification\nPreferences" as UC1
  usecase "Toggle Alert Category\nOn / Off" as UC2
  usecase "Check Category Preference\nfor Triggered Event" as UC3
  usecase "Generate & Deliver\nNotification" as UC4
  usecase "Block Push & Inbox Entry" as UC5
}

U --> UC1
UC1 <.. UC2 : <<extend>>\n[If user switches a specific category]

S --> UC3
UC3 <.. UC4 : <<extend>>\n[If the alert category is enabled]
UC3 <.. UC5 : <<extend>>\n[If the alert category is disabled]
@enduml
